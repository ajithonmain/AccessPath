{
  "name": "@accesspath/embed",
  "version": "0.1.0",
  "type": "module",
  "description": "Drop-in accessibility widget for any website via a single script tag. No build step.",
  "license": "MIT",
  "author": "Ajith M Jose",
  "homepage": "https://accesspath-6ur.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajithonmain/AccessPath.git",
    "directory": "packages/embed"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "ada",
    "accessibility-widget",
    "accessibility-overlay",
    "accessibility-toolbar",
    "accessibility-panel",
    "web-accessibility",
    "wcag-widget",
    "ada-compliance",
    "dyslexia",
    "screen-reader",
    "self-hosted",
    "open-source",
    "userway-alternative",
    "accessibe-alternative",
    "script-tag",
    "no-build",
    "wordpress",
    "shopify",
    "wix",
    "cdn"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/embed.js",
  "unpkg": "./dist/embed.js",
  "jsdelivr": "./dist/embed.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@accesspath/core": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "~5.1.3",
    "vite": "^5.4.0"
  },
  "bugs": {
    "url": "https://github.com/ajithonmain/AccessPath/issues"
  }
}

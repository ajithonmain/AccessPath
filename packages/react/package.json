{
  "name": "@accesspath/react",
  "version": "0.1.4",
  "type": "module",
  "description": "React component and hook for the AccessPath accessibility widget.",
  "license": "MIT",
  "author": "Ajith M Jose",
  "homepage": "https://accesspath-6ur.pages.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ajithonmain/AccessPath.git",
    "directory": "packages/react"
  },
  "keywords": [
    "accessibility",
    "a11y",
    "wcag",
    "ada",
    "accessibility-widget",
    "accessibility-overlay",
    "accessibility-toolbar",
    "accessibility-panel",
    "web-accessibility",
    "wcag-widget",
    "ada-compliance",
    "dyslexia",
    "screen-reader",
    "self-hosted",
    "open-source",
    "userway-alternative",
    "accessibe-alternative",
    "react",
    "react-component",
    "react-hook"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json --emitDeclarationOnly && vite build",
    "typecheck": "tsc --noEmit",
    "demo": "vite --config demo/vite.config.ts"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "@accesspath/core": "^0.1.4"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "~5.1.3",
    "vite": "^5.4.0"
  },
  "bugs": {
    "url": "https://github.com/ajithonmain/AccessPath/issues"
  }
}
